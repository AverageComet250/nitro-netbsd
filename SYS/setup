#!/bin/sh 
# Start Critical System Services before handing off the nitro for non-criticals
# Criticals (using rc.d names):
# - fsck_root (technically optional)
# - resize_root (also technically optional)
# - root
# - bootconf 
#   - currently going to ignore this, nitro doesn't have runlevels but
#     can probably map it w/ symlinks
# - ttys
#
# The plan - SYS/setup mounts root and then sets up a single tty
#
# This should be enough to prove that the system works, then I can port the rest
# of the rc scripts until I have a full set of system services

printf "Hello from NetBSD\n"

# /etc/rc.d/root
umount -a >/dev/null 2>&1
mount /
rm -f /fastboot

# /etc/rc.d/mountall
mount -a

# /etc/rc.d/ttys
ttyflags -a
if [ -c /dev/ttyp0 ]; then
        chmod 666 /dev/tty[p-uw-zP-T][0-9a-zA-Z]
fi

# getty should now start
