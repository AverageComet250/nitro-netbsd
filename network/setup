#!/bin/sh
# 1. set a hostname
# - set a domainname
# 2. start loopback
# - start ipv6 here
# 3. autosetup all interfaces (this'll be stolen from rc.d/network)
#   - for now just hardcode this for iwm0 using my current /etc/ifconfig.iwm0
# - if aliases setup here
# - defaultroute (/etc/mygate) is skipped and populated w/ dhcpcd instead
# 4. run resolvconf and setup dns
#   - might just force this to google for now
# - `/etc/netstart.local start` - doesn't exist on my system so will come back
#   to this
#
# networking also needs a stop job, but that's a task for later

hostname="chalice"

echo "setting up networking"
hostname $hostname # taking suggestions for a better hostname (yoga 720)
ifconfig iwm0 up
ifconfig iwm0 media autoselect

# connect to wifi
# this should be its own job
wpa_supplicant -B -i iwm0 -D bsd -c /etc/wpa_supplicant.conf

# start dhcpcd
nitroctl start dhcpcd
